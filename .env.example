# URL base da API (Spring Boot). Sem barra no final.
#
# Em DEV isto é o destino do proxy do Vite: o front chama /api na própria
# origem e o Vite repassa para cá, então não há CORS envolvido
# (ver vite.config.ts).
#
# Em BUILD de produção é a URL que o navegador chama direto — aí o CORS do
# backend precisa liberar o domínio onde o front estiver publicado.
VITE_API_URL=http://localhost:8080
